rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function userData() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; }
    function villageMember(villageId) {
      return signedIn()
        && firestore.get(/databases/(default)/documents/villages/$(villageId)/members/$(request.auth.uid)).data.status == 'active';
    }
    function memberOf(villageId) {
      // 사진 업로드는 마을 가입 기록을 우선 확인한다. 사용자 프로필 값이 늦게
      // 반영되어도 active 가입자는 자신의 마을 사진을 올릴 수 있다.
      return villageMember(villageId) || (signedIn() && userData().villageId == villageId);
    }
    function adminOf(villageId) {
      return memberOf(villageId) && userData().role in ['leader', 'secretary'];
    }
    match /site/{file=**} {
      allow read: if true;
      allow write: if signedIn() && userData().isSiteAdmin == true && request.resource.size < 10 * 1024 * 1024;
    }
    // 사진은 로그인한 본인이 자기 폴더에만 업로드할 수 있고, 마을 가입 기록도 확인한다.
    match /villages/{villageId}/photos/{uid}/{file=**} {
      allow read: if true;
      allow write: if memberOf(villageId) && request.auth.uid == uid && request.resource.size < 10 * 1024 * 1024;
    }
    match /villages/{villageId}/{folder}/{file=**} {
      allow read: if memberOf(villageId);
      allow write: if adminOf(villageId) && request.resource.size < 100 * 1024 * 1024;
    }
  }
}
