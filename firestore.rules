rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function memberOf(villageId) { return signedIn() && userData().villageId == villageId; }
    function adminOf(villageId) { return memberOf(villageId) && userData().role in ['leader', 'secretary']; }
    function isSiteAdmin() { return signedIn() && userData().isSiteAdmin == true; }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'member' && request.resource.data.villageId == null;
      allow read: if signedIn() && (request.auth.uid == uid || adminOf(resource.data.villageId) || isSiteAdmin());
      allow update: if signedIn() && (request.auth.uid == uid || isSiteAdmin())
        && (request.resource.data.role == resource.data.role
          || request.resource.data.role in ['member', 'leader', 'secretary', 'women_leader', 'youth_leader', 'elder']);
      allow list: if isSiteAdmin();
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isSiteAdmin();
    }

    match /aiLogs/{logId} {
      allow read: if isSiteAdmin();
      allow create: if signedIn();
    }

    // collectionGroup 쿼리용 - 공개 글은 누구나 읽기 허용
    match /{path=**}/posts/{postId} {
      allow read: if resource.data.isPublic == true;
    }

    match /villages/{villageId} {
      allow get: if resource.data.settings.isPublic == true || memberOf(villageId) || isSiteAdmin();
      allow list: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if adminOf(villageId) || isSiteAdmin()
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']));
      allow delete: if signedIn() && (resource.data.createdBy == request.auth.uid || isSiteAdmin());

      match /members/{uid} {
        allow read: if memberOf(villageId) || request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.role in ['member', 'leader', 'secretary', 'women_leader', 'youth_leader', 'elder'];
        allow update: if adminOf(villageId);
      }

      match /posts/{postId} {
        allow read: if resource.data.isPublic == true || memberOf(villageId);
        allow create: if memberOf(villageId) && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if memberOf(villageId) && (resource.data.authorId == request.auth.uid || adminOf(villageId));
        allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'commentCount']);
        match /likes/{uid} { allow read: if true; allow create, delete: if (memberOf(villageId) || resource.data.isPublic == true) && signedIn() && request.auth.uid == uid; }
        match /comments/{commentId} {
          allow read: if true;
          allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
          allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
        }
      }

      match /todos/{id} { allow read, write: if adminOf(villageId); }
      match /schedule/{id} { allow read, write: if adminOf(villageId); }
      match /documents/{id} { allow read: if memberOf(villageId); allow write: if adminOf(villageId); }
      match /aiTasks/{taskId} {
        allow read: if memberOf(villageId);
        allow create, update, delete: if adminOf(villageId);
      }
      match /finances/{id} { allow read, write: if adminOf(villageId); }
      match /meetings/{id} { allow read, write: if adminOf(villageId); }
    }

    match /invites/{code} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && adminOf(request.resource.data.villageId);
    }
  }
}
